{
  "name": "metaboard-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env src/index.ts",
    "seed": "node --env-file=.env seed/seed.ts",
    "seed:economy": "node --env-file=.env seed/add-economy-comps.ts",
    "test": "node --test src/assistant/*.test.ts",
    "typecheck": "node ../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "eval": "node --env-file=.env src/assistant/eval/run.ts",
    "build:knowledge": "node src/assistant/eval/build-knowledge.ts",
    "test:rag": "node src/assistant/eval/rag.ts",
    "test:accuracy": "node --env-file=.env src/assistant/eval/accuracy.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1"
  }
}
