# Copy to apps/api/.env.
PORT=4000
NODE_ENV=development

# DATABASE_URL — production không dùng URL trực tiếp của Supabase.
# Supabase có ba đường, chỉ một đường dùng được từ Render:
#   Direct   db.<ref>.supabase.co:5432        -> IPv6-only; Render không có IPv6
#   Pooler session      aws-…pooler.supabase.com:5432  -> IPv4, CHỌN ĐƯỜNG NÀY
#   Pooler transaction  aws-…pooler.supabase.com:6543  -> IPv4 nhưng cắt prepared
#        statements, cursor, session state — API này có transaction giữ client
#        (comps.ts, tft.ts) và DDL lazy (accounts.ts) nên không phải đường an toàn.
# Copy nguyên "URI" từ dashboard (nó đã kèm ?sslmode=require); nếu tự gõ thì
# URL-encode mật khẩu, key random của Supabase chứa ký tự đặc biệt.
DATABASE_URL=postgres://metaboard:metaboard@localhost:5432/metaboard
# Số connection tối đa process này giữ. Pooler có ngân sách server connection
# nhỏ và hữu hạn, nên đây là biến phải nhìn trước khi tăng traffic.
#PG_POOL_MAX=8
# Owner of /admin. Only read while no admin exists: the seed or the API boot
# creates/adopts this account with role=admin, and after the first sign-in both
# variables can be deleted from the host.
ADMIN_EMAIL=owner@example.com
ADMIN_SEED_PASSWORD=change-me
REFRESH_TOKEN=change-me

# req.ip là khoá của dedupe vote/view và limiter đăng nhập. Production mặc định
# là 1 hop (Render/Vercel luôn đứng sau proxy); chỉ đặt 0 khi chạy thẳng không proxy.
#TRUST_PROXY=1

# TFT Assistant. Keep disabled until Ollama and the model are ready.
# Giá trị dưới đây là mặc định lúc boot. Admin có thể ghi đè từng cái mà không
# cần redeploy: bảng app_settings (UI ở /admin/settings) được copy lên
# process.env khi API khởi động và ngay sau mỗi lần lưu; xoá row là trả lại env.
# API key không nằm trong danh sách ghi đè — credential luôn ở env của host.
ASSISTANT_ENABLED=false
ASSISTANT_BASE_URL=http://127.0.0.1:11434
ASSISTANT_MODEL=qwen3.5:9b
ASSISTANT_LOAD_TIMEOUT_MS=60000
ASSISTANT_REQUEST_TIMEOUT_MS=45000
ASSISTANT_RATE_LIMIT=12
ASSISTANT_DAILY_REQUESTS=200
# Số câu trả lời được tạo đồng thời trên một instance. Trước đây là 1: một câu
# 45 giây chặn mọi người phía sau. Đây là cap bảo vệ rate limit của provider.
#ASSISTANT_MAX_CONCURRENCY=2

# LLM provider: ollama (local, default) | google (Gemini API) | openai (OpenAI-compatible).
# Remote providers stream over HTTPS and need their own API key; ollama stays loopback-only.
#ASSISTANT_PROVIDER=ollama
#GOOGLE_API_KEY=
#GOOGLE_MODEL=gemini-3.5-flash-lite
#OPENAI_API_KEY=
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-4o-mini
# OpenRouter: with only OPENROUTER_API_KEY set, the openai provider targets
# openrouter.ai automatically. Free models are reasoning models; the adapter
# raises the token budget and repairs their JSON syntax.
#OPENROUTER_API_KEY=
#OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Vietnamese speech-to-text cho Coach AI. API đi hết chuỗi provider có key cho
# mỗi lượt nói (failover); provider vừa trả 429/401/402 bị bỏ qua một thời gian.
# Thứ tự đã đo (scripts/stt-bench.mjs): deepgram > groq > elevenlabs > openai > gemini.
# OpenRouter không tự vào chuỗi (endpoint audio cần số dư riêng, 402 nếu chưa nạp)
# — đặt STT_PROVIDER=openrouter khi đã nạp tiền.
#STT_PROVIDER=                # ép 1 provider: deepgram|groq|elevenlabs|openai|gemini|openrouter
#STT_LANGUAGE=vi
#STT_MAX_CONCURRENCY=4
#STT_BUSY_COOLDOWN_MS=30000   # thời gian bỏ qua một provider vừa trả 429 (tôn trọng Retry-After, tối đa 600000)
#STT_CHAIN_BUDGET_MS=45000     # tổng thời gian tối đa cho một lượt đi hết chain
#DEEPGRAM_API_KEY=
#STT_DEEPGRAM_MODEL=nova-3
#GROQ_API_KEY=
#STT_GROQ_MODEL=whisper-large-v3-turbo
#ELEVENLABS_API_KEY=
#STT_ELEVENLABS_MODEL=scribe_v2
#OPENAI_API_KEY=
#STT_OPENAI_MODEL=gpt-4o-transcribe
#STT_OPENAI_BASE_URL=
#GOOGLE_API_KEY=
#STT_GEMINI_MODEL=gemini-3.1-flash-lite

# TTS — đọc câu trả lời Coach AI. Engine chính chọn bằng TTS_PROVIDER, engine còn
# lại tự động đọc thay từng chunk khi engine chính lỗi. Cả hai lỗi thì client báo
# lỗi; không còn fallback Web Speech API.
#TTS_PROVIDER=deepgram             # deepgram | vieneu; đổi qua lại chỉ cần biến này
# Deepgram: tiếng Việt chỉ có trên Flux TTS (/v2/speak, Early Access chưa chuẩn hoá
# số/ngày), dùng chung DEEPGRAM_API_KEY với STT ở trên. Batch Flux khá chậm
# (~4-6 s/chunk 60-150 ký tự khi đo trên máy dev), nên dùng VieNeu nếu cần phản hồi nhanh.
#DEEPGRAM_TTS_MODEL=flux-minh-vi  # flux-minh-vi (nam, mặc định) | flux-hoa-vi (nữ)
# VieNeu chỉ bật khi có VIENEU_TTS_URL; engine local đã bị bỏ khỏi luồng chạy.
# Cloud:  VIENEU_TTS_URL=https://api.vieneu.io/api + VIENEU_TTS_API_KEY=vn_sk_...
#VIENEU_TTS_URL=https://api.vieneu.io/api
#VIENEU_TTS_MODEL=vieneu-v4       # cloud tính tiền theo ký tự; model càng mới càng đắt
#VIENEU_TTS_FORMAT=wav            # wav | mp3 | pcm | opus | ulaw
#VIENEU_TTS_API_KEY=
#VIENEU_TTS_VOICE=Hải Đăng        # Trúc Ly / Thiện Minh / Mai Anh ...
#VIENEU_TTS_PROBE_TIMEOUT_MS=4000 # timeout thăm /v1/voices; cloud qua WAN nên có thể đặt 6000
# Một chunk gửi lên engine tối đa bao nhiêu ký tự (40-400, mặc định 150).
# Chunk nhỏ hơn = audio đầu tiên nhanh hơn nhưng nhiều request hơn.
#TTS_CHUNK_CHARACTERS=150
# VieNeu chỉ nhận ~2 request đồng thời; phần vượt chờ trong queue, quá thời gian thì trả 429.
#TTS_MAX_CONCURRENCY=2
#TTS_QUEUE_WAIT_MS=5000
#TTS_TIMEOUT_MS=45000

# Accounts & auth (email + password, Google OAuth). Sessions: cookie mb_session (30 ngày).
# Mailer mặc định là console — link xác minh in ra log. Ở NODE_ENV=production
# getMailer() từ chối chạy console mailer (log của host ai đọc cũng được, và link
# đó là credential): phải cắm provider thật trong src/mailer.ts trước khi bật xác minh.
#AUTH_WEB_ORIGIN=http://localhost:4173
# Cookie mặc định có Secure khi NODE_ENV=production. Chỉ đặt false cho local dev.
#AUTH_SECURE_COOKIES=false
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET=
#GOOGLE_OAUTH_REDIRECT_URI=
# Tạm tắt xác minh email đến khi launch production (đăng ký = tự xác minh + đăng nhập ngay).
# Đặt true khi lên production để bắt buộc bấm link xác minh trước khi đăng nhập.
#AUTH_REQUIRE_EMAIL_VERIFICATION=false
