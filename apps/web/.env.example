# Copy to .env.local for the Next app.
# Đích của rewrite /api/* và của các lệnh server-side. Trên Vercel phải có ở cả
# build lẫn runtime — thiếu là build vẫn xanh rồi 500 lúc chạy.
BACKEND_URL=http://127.0.0.1:4000
SITE_URL=http://localhost:4173
# Trần một lần gọi API khi render trang phía server. API cold start thì backendJson
# retry một lần; hai lượt waiting quá con số này là trang fail, không treo.
#BACKEND_FETCH_TIMEOUT_MS=8000
# OAuth redirect mặc định trỏ về origin này qua /api proxy (AUTH_WEB_ORIGIN ở API).
# Turnstile lấy site key lúc chạy từ /api/auth/turnstile; cả hai TURNSTILE_* key chỉ đặt ở API.
# Phải khớp API (Render): chỉ "enforce" mới chặn guest ở /assistant và bật TTS
# theo ledger. Để trống giữ nguyên hành vi cũ. Vercel đọc biến này lúc build và
# runtime — đổi cùng lúc với API ở #95.
#MEMBERSHIP_ENFORCEMENT=enforce

