{
  "name": "metaboard-monorepo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @metaboard/web",
    "dev:api": "npm run dev --workspace @metaboard/api",
    "build": "npm run build --workspace @metaboard/web",
    "start:web": "npm run start --workspace @metaboard/web",
    "start:api": "npm run start --workspace @metaboard/api",
    "fetch-data": "npm run fetch-data --workspace @metaboard/web",
    "fetch-wisps": "npm run fetch-wisps --workspace @metaboard/web",
    "fetch-loot": "npm run fetch-loot --workspace @metaboard/web",
    "fetch-comp-tips": "npm run fetch-comp-tips --workspace @metaboard/web",
    "extract-translations": "npm run extract-translations --workspace @metaboard/web",
    "test:server": "npm test --workspace @metaboard/api",
    "typecheck": "npm run typecheck --workspace @metaboard/web && npm run typecheck --workspace @metaboard/api",
    "test:e2e": "playwright test",
    "test:eval": "npm run eval --workspace @metaboard/api",
    "build:knowledge": "npm run build:knowledge --workspace @metaboard/api",
    "test:rag": "npm run test:rag --workspace @metaboard/api",
    "test:accuracy": "npm run test:accuracy --workspace @metaboard/api"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "typescript": "^5.9.0"
  }
}
