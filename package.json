{
  "name": "metaboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 4173",
    "fetch-data": "node scripts/fetch-tft.mjs && node scripts/fetch-metatft-items.mjs",
    "fetch-wisps": "node scripts/fetch-wisps.mjs",
    "fetch-loot": "node scripts/fetch-loot-tables.mjs",
    "fetch-comp-tips": "node scripts/fetch-tftacademy-tips.mjs",
    "extract-translations": "node scripts/extract-translation-tasks.mjs",
    "test:server": "npm --prefix server test",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "test:eval": "npm --prefix server run eval",
    "build:knowledge": "npm --prefix server run build:knowledge",
    "test:rag": "npm --prefix server run test:rag",
    "test:accuracy": "npm --prefix server run test:accuracy"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
