{
  "name": "tftiq-monorepo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @tftiq/web",
    "dev:api": "npm run dev --workspace @tftiq/api",
    "build": "npm run build --workspace @tftiq/web",
    "start:web": "npm run start --workspace @tftiq/web",
    "start:api": "npm run start --workspace @tftiq/api",
    "extract-translations": "npm run extract-translations --workspace @tftiq/web",
    "test:server": "npm test --workspace @tftiq/api",
    "test:web": "node --test 'apps/web/lib/*.test.ts'",
    "typecheck": "npm run typecheck --workspace @tftiq/web && npm run typecheck --workspace @tftiq/api",
    "test:e2e": "playwright test",
    "test:eval": "npm run eval --workspace @tftiq/api",
    "build:knowledge": "npm run build:knowledge --workspace @tftiq/api",
    "test:rag": "npm run test:rag --workspace @tftiq/api",
    "test:quality": "npm run test:quality --workspace @tftiq/api",
    "test:accuracy": "npm run test:accuracy --workspace @tftiq/api"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "typescript": "^5.9.0"
  }
}
