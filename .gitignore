# dependencies
node_modules/

# next.js
.next/
out/
build/
next-env.d.ts

# env — never commit secrets (ADMIN_PASSWORD, REFRESH_TOKEN)
.env*
# the templates carry no values; they are how a fresh clone learns which keys exist
!.env.example

# local editor and shell settings
.vscode/
.bash_profile

# icon downloads — regenerate with `npm run fetch-data` (lib/tft.json is tracked; it's small and the build imports it)
# loot table art — regenerate with `npm run fetch-loot`
#apps/web/public/tft/
apps/web/scripts/.cache/
apps/api/models/

# capture artefacts (source-site screenshots and rebuild output are large)
capture/source/
capture/rebuild/

# tftips capture — raw SSR HTML is ~209MB and regenerable via the sitemap crawl;
# the per-page json/ dirs duplicate the top-level structured files.
capture/tftips/raw/
capture/tftips/json/champions/
capture/tftips/json/traits/
capture/tftips/json/augs/
capture/tftips/json/items/
capture/tftips/json/comps/
capture/tftips/json/pages/
capture/tftips/assets-index/

# misc
*.tsbuildinfo
.DS_Store
coverage/
*.log

# playwright
test-results/
playwright-report/

# Qoder ImageGen scratch output — the sheets that matter live in apps/web/characters
vibe_images/

# python byte caches from the page-mascot skill scripts
__pycache__/
